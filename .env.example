# ---------------------------------------------------------------------------
# Auth Foundation configuration reference.
# Copy to .env for local development. Production secrets must come from a
# secret manager / KMS, never committed here (SECURITY_SPEC.md).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/uzz_crm?schema=public"
# Separate, disposable database for `npm run test:e2e:real-db` (tables are TRUNCATEd).
# Must NOT be the same database as DATABASE_URL - the test setup refuses to run.
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/uzz_crm_test?schema=public"

# --- JWT access token ---------------------------------------------------------
# TTL is a technical assumption (OPEN_QUESTIONS.md #10) - keep short & configurable.
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL_SECONDS=900

# --- Refresh token ------------------------------------------------------------
# TTL is a technical assumption (OPEN_QUESTIONS.md #11).
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=uzz_refresh
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
# lax in dev; set to "strict" and NODE_ENV=production for prod deployments.

# --- CSRF (double-submit cookie for cookie-based refresh flow) ---------------
CSRF_COOKIE_NAME=uzz_csrf

# --- Password hashing (Argon2id) ---------------------------------------------
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Field-level encryption (AES-256-GCM) -------------------------------------
# Foundation only - no User/profile field currently uses it (see
# OPEN_QUESTIONS.md #27-28). Reserved for future Booking/Contract PII fields.
# Each key must be 32 bytes, base64-encoded. Add new versions, never remove
# old ones until all data re-encrypted.
ENCRYPTION_KEY_CURRENT_VERSION=v1
ENCRYPTION_KEY_V1="base64:REPLACE_WITH_32_BYTE_KEY"

# HMAC key for blind indexes (exact search by passport/phone over encrypted data).
# 32 random bytes, base64. MUST differ from the encryption keys. Changing it
# requires recomputing every *Idx column.
BLIND_INDEX_KEY_V1="base64:REPLACE_WITH_ANOTHER_32_BYTE_KEY"

# --- CORS ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# --- Rate limiting --------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=5

# --- SMTP (generic, provider-agnostic - point this at Gmail/SES/Mailgun/etc) --
# Confirmation-code emails to Director(s) will not be delivered until this is
# set. Leaving it empty is safe: the action still gets created and is visible
# via GET /api/v1/confirmations/pending for a Director to approve in-app.
#
# Local development: `docker compose -f docker-compose.dev.yml up -d mailpit`, then
# SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURE=false with EMPTY SMTP_USER/SMTP_PASS
# (auth-less SMTP is accepted only when NODE_ENV != production). Inbox UI:
# http://localhost:8025. In production SMTP_USER and SMTP_PASS are both required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CRM Security <no-reply@example.com>"

# --- Confirmation codes (maker-checker approval for account create/disable) ---
CONFIRMATION_CODE_TTL_SECONDS=600
CONFIRMATION_CODE_MAX_ATTEMPTS=5

# --- One-time bootstrap seed (prisma/seed.ts) - only used by `npx prisma db seed` ---
# Only takes effect on a completely empty User table. SEED_DIRECTOR_EMAIL is
# optional but recommended: without it, the first Director cannot receive
# confirmation-code emails and must approve via GET /confirmations/pending.
SEED_DIRECTOR_USERNAME=
SEED_DIRECTOR_PASSWORD=
SEED_DIRECTOR_FULL_NAME=
SEED_DIRECTOR_EMAIL=

# --- Первый Director (только для npm run seed:director / prisma db seed) -----
# Скрипт срабатывает ТОЛЬКО если таблица User полностью пустая.
# Не хранить настоящий production-пароль в этом файле.
SEED_DIRECTOR_USERNAME=director
SEED_DIRECTOR_PASSWORD="change-me-strong-password-123"
SEED_DIRECTOR_FULL_NAME="Директор"

# --- CRM MVP -------------------------------------------------------------------
# Business calendar for shifts, missed-shift job and daily reports.
# OPEN QUESTION: working week / holidays are not defined in the TZ.
BUSINESS_TIMEZONE=Asia/Bishkek
WORKING_WEEKDAYS=1,2,3,4,5
CRON_ENABLED=true
MISSED_SHIFT_LOOKBACK_DAYS=7

# Private encrypted file storage (contracts, receipts, avatars). Keep outside
# any public web root; back it up together with the database.
FILE_STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
JSON_BODY_LIMIT=100kb

# Legal documents every user must accept (current version) before using the API.
LEGAL_REQUIRED_CONSENTS=privacy_policy,terms_of_use,personal_data_processing

# Swagger UI at /api/v1/docs. Always disabled when NODE_ENV=production.
SWAGGER_ENABLED=true

# Express trust proxy: false (direct), a hop count ("1") or a subnet list.
# Set only when really behind that proxy - otherwise clients can spoof IPs.
TRUST_PROXY=false

# --- Cookies for a frontend on another site (staging) --------------------------
# COOKIE_SECURE defaults to true outside development/test (always true in production).
# REFRESH_COOKIE_SAMESITE=none requires COOKIE_SECURE=true.
COOKIE_SECURE=
# JWT_ACCESS_SECRET must be >= 32 characters outside development/test.

# --- Demo data (staging only, never runs with NODE_ENV=production) -------------
DEMO_SEED=false
DEMO_SEED_PASSWORD=
