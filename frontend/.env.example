# Публичный базовый адрес API. Значение включает префикс /api/v1.
# Формат: https://<хост>/api/v1
# Например: https://uzz-crm-api.onrender.com/api/v1
#
# Переменные с префиксом NEXT_PUBLIC_ попадают в браузер: не размещайте в них
# пароли, токены, cookie и bootstrap-секреты.
NEXT_PUBLIC_API_URL=https://uzz-crm-api.onrender.com/api/v1
