{
  "name": "uzz-crm-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CRM backend for Uluu Zhibek Zholu",
  "license": "UNLICENSED",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:director": "ts-node prisma/seed.ts",
    "test:e2e:real-db": "jest --config ./test/jest-real-db.json --runInBand",
    "data:encrypt-pii": "ts-node prisma/encrypt-existing-pii.ts",
    "ops:set-director-email": "ts-node prisma/set-director-email.ts",
    "backup:keygen": "ts-node prisma/backup-keygen.ts",
    "backup:agent-token": "ts-node prisma/backup-agent-token.ts",
    "backup:inspect": "ts-node prisma/backup-inspect.ts",
    "backup:restore": "ts-node prisma/backup-restore.ts",
    "ops:delete-users": "ts-node prisma/ops-delete-users.ts",
    "seed:demo-roles": "ts-node prisma/seed-demo-roles.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.1",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "2.2.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "multer": "2.4.0",
    "body-parser": "1.20.8",
    "lodash": "4.18.1",
    "qs": "6.16.0",
    "file-type": "21.3.4",
    "@nestjs/swagger": {
      "js-yaml": "4.3.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@nestjs/schedule": {
      "uuid": "11.1.1"
    }
  }
}
